#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

python_candidates=()
if [[ -n "${WORK_GOVERNANCE_PYTHON:-}" ]]; then
  python_candidates+=("${WORK_GOVERNANCE_PYTHON}")
fi
python_candidates+=("python3.12" "/opt/homebrew/bin/python3" "/usr/local/bin/python3" "python3")

for python_bin in "${python_candidates[@]}"; do
  if [[ "${python_bin}" == */* ]]; then
    [[ -x "${python_bin}" ]] || continue
  elif ! command -v "${python_bin}" >/dev/null 2>&1; then
    continue
  fi
  if "${python_bin}" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)' >/dev/null 2>&1; then
    exec "${python_bin}" "${script_dir}/workctl.py" "$@"
  fi
done

printf '%s\n' "PYTHON_3_12_REQUIRED: set WORK_GOVERNANCE_PYTHON to a Python >= 3.12 executable" >&2
exit 2
